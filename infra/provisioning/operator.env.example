# Nonsecret Compose interpolation settings; use --env-file /path/to/operator.env.
# API snapshots these values; worker executes exactly the saved configuration.
WPMGR_PROVISIONING_ENABLED=true
WPMGR_PROVISIONING_OPERATOR_TENANT_ID=replace-with-owner-tenant-uuid
WPMGR_PROVISIONING_WORKER_ENV_FILE=/etc/wpmgr/provisioning-worker.env
# Pre-create mode 0700. Host and worker must see identical absolute path.
WPMGR_PROVISIONING_STATE_DIR=/var/lib/wpmgr/provisioning
WPMGR_PROVISIONING_MARIADB_ADDRESS=host.docker.internal:3306
WPMGR_PROVISIONING_MARIADB_TLS=true
WPMGR_PROVISIONING_PROXY_NETWORK=proxy
WPMGR_PROVISIONING_WORDPRESS_IMAGE=wordpress:6.8.2-php8.3-apache
WPMGR_PROVISIONING_WPCLI_IMAGE=wordpress:cli-2.12.0-php8.3
WPMGR_PROVISIONING_AGENT_PACKAGE=https://control.example.com/approved/fleet-agent.zip
WPMGR_PROVISIONING_CONTROL_PLANE_URL=https://control.example.com
