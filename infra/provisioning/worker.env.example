# Copy outside tracked files, chmod 600, use worker env_file only.
# Match the existing control-plane app-role password and age identity.
WPMGR_DB_PASSWORD=replace-with-existing-app-role-password
WPMGR_SITE_DEST_AGE_SECRET=replace-with-existing-control-plane-age-secret
WPMGR_PROVISIONING_MARIADB_ADDRESS=host.docker.internal:3306
WPMGR_PROVISIONING_MARIADB_USERNAME=wpmgr_provisioner
WPMGR_PROVISIONING_MARIADB_PASSWORD=replace-with-host-provisioner-password
WPMGR_PROVISIONING_MARIADB_TLS=true
WPMGR_PROVISIONING_PROXY_NETWORK=proxy
# Operator approves exact versions; no floating tags.
WPMGR_PROVISIONING_WORDPRESS_IMAGE=wordpress:6.8.2-php8.3-apache
WPMGR_PROVISIONING_WPCLI_IMAGE=wordpress:cli-2.12.0-php8.3
WPMGR_PROVISIONING_AGENT_PACKAGE=https://control.example.com/approved/fleet-agent.zip
WPMGR_PROVISIONING_CONTROL_PLANE_URL=https://control.example.com
